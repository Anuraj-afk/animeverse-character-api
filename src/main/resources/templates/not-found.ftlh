<#import "layout.ftlh" as layout>

<@layout.page title="Character not found">
    <main class="container">
        <h2 class="section-title">Character not found</h2>
        <p>We couldn't find that character. Return to the gallery to browse the available characters.</p>
        <a class="pure-button pure-button-primary" href="/">Back to Gallery</a>
    </main>
</@layout.page>
